#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

# Database connection driver (MySQLi, SQLite3, Postgre, etc.)
DB_CONNECTION = MySQLi

# Database host (use 'localhost' when running locally, 'mysql' when running app inside Docker)
DB_HOST = localhost

# Database port
DB_PORT = 3306

# Database name
DB_DATABASE = pizzaria_db

# Database username
DB_USERNAME = pizzaria_user

# Database password
DB_PASSWORD = root

# Database table prefix (optional)
DB_PREFIX =

# Enable database debug mode (true/false)
DB_DEBUG = true

#--------------------------------------------------------------------
# DOCKER DATABASE (when using docker-compose)
#--------------------------------------------------------------------

# Uncomment and use 'mysql' as host when running the app inside Docker
# DB_HOST = mysql

#--------------------------------------------------------------------
# PHPMYADMIN
#--------------------------------------------------------------------

# Port for accessing phpMyAdmin (default: 8081)
PHPMYADMIN_PORT = 8081
